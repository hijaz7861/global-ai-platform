APP_NAME=Global AI Platform
APP_VERSION=0.2.0
ENVIRONMENT=development
DATABASE_URL=sqlite:///./global_ai_platform.db
SECRET_KEY=
PREVIOUS_SECRET_KEYS=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
MFA_ENROLLMENT_EXPIRE_MINUTES=10
ORDER_PAYMENT_EXPIRE_MINUTES=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_REQUEST_LIMIT=5
PASSWORD_RESET_WINDOW_MINUTES=15
AUTH_LOGIN_ATTEMPT_LIMIT=10
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_ACCOUNT_LOCKOUT_THRESHOLD=10
AUTH_ACCOUNT_LOCKOUT_MINUTES=15
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=30
REQUIRE_EMAIL_VERIFICATION=true
AUTH_REGISTER_ATTEMPT_LIMIT=5
AUTH_REGISTER_WINDOW_MINUTES=60
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
PLATFORM_ADMIN_EMAILS=
# Comma-separated trusted proxy IPs/CIDRs; forwarded headers are ignored unless the peer is trusted.
TRUSTED_PROXY_IPS=
AI_LIVE_CALLS_ENABLED=false
# Retry a failed primary request on the configured fallback only for timeout/connection/429/5xx errors.
AI_AUTO_FAILOVER_ENABLED=false
# Provider names: openai-compatible, openai, groq, openrouter, together, anthropic, gemini, local.
AI_PRIMARY_PROVIDER=openai-compatible
AI_FALLBACK_PROVIDER=
# Local provider URLs are loopback-only and require explicit opt-in.
AI_ALLOW_LOCAL_ENDPOINTS=false
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# Optional secondary provider for explicit request-level selection; leave all blank to disable.
AI_FALLBACK_API_KEY=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_MODEL=
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=512
AI_MAX_RESPONSE_BYTES=1048576
AI_DAILY_REQUEST_LIMIT=0
# Conservative daily agent token reservation budget; 0 disables the token cap.
AI_DAILY_TOKEN_LIMIT=0
# Durable AI worker polling/lease settings used by compose.yaml.
AI_WORKER_POLL_SECONDS=2
AI_WORKER_LEASE_SECONDS=300


# Governed GitHub draft-PR writing. Disabled by default; never enable without
# a GitHub App installation, PostgreSQL nonce storage, and trusted approval keys.
AI_REPOSITORY_WRITES_ENABLED=false
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PEM=
GITHUB_REPOSITORY_ALLOWLIST=
AI_SANDBOX_ATTESTATION_HMAC_KEY=
AI_HUMAN_APPROVAL_HMAC_KEY=

# Isolated proposal validation worker. Disabled by default; commands and trusted
# tests are operator-controlled, never supplied by an AI task or API request.
AI_SANDBOX_ENABLED=false
AI_SANDBOX_IMAGE=
AI_SANDBOX_TRUSTED_TEST_DIRECTORY=
# JSON object with exactly unit/security/regression argv arrays.
AI_SANDBOX_VALIDATION_COMMANDS={}
AI_SANDBOX_TIMEOUT_SECONDS=120
AI_SANDBOX_MEMORY_LIMIT=512m
AI_SANDBOX_CPU_LIMIT=1.0
AI_SANDBOX_PIDS_LIMIT=128
