APP_NAME=Global AI Platform
APP_VERSION=0.2.0
ENVIRONMENT=development
DATABASE_URL=sqlite:///./global_ai_platform.db
SECRET_KEY=
PREVIOUS_SECRET_KEYS=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
MFA_ENROLLMENT_EXPIRE_MINUTES=10
ORDER_PAYMENT_EXPIRE_MINUTES=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_REQUEST_LIMIT=5
PASSWORD_RESET_WINDOW_MINUTES=15
AUTH_LOGIN_ATTEMPT_LIMIT=10
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_ACCOUNT_LOCKOUT_THRESHOLD=10
AUTH_ACCOUNT_LOCKOUT_MINUTES=15
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=30
REQUIRE_EMAIL_VERIFICATION=true
AUTH_REGISTER_ATTEMPT_LIMIT=5
AUTH_REGISTER_WINDOW_MINUTES=60
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
PLATFORM_ADMIN_EMAILS=
# Comma-separated trusted proxy IPs/CIDRs; forwarded headers are ignored unless the peer is trusted.
TRUSTED_PROXY_IPS=
AI_LIVE_CALLS_ENABLED=false
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# Optional secondary provider for explicit request-level selection; leave all blank to disable.
AI_FALLBACK_API_KEY=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_MODEL=
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=512
AI_MAX_RESPONSE_BYTES=1048576
AI_DAILY_REQUEST_LIMIT=0
